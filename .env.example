# Copy this file to .env and fill in your real values. Never commit .env.

# Grok / xAI API (idea selection, curation, day-plan assembly)
GROK_API_KEY=your_xai_api_key_here
GROK_API_URL=https://api.x.ai/v1/chat/completions
# Prefer a fast non-reasoning variant: feed generation is a selection/copy
# task and slow reasoning models can exceed the request timeout. Check
# available ids via GET https://api.x.ai/v1/models with your key.
GROK_MODEL=grok-4.20-0309-non-reasoning

# Google Maps (Places API New + Geocoding) — real venue grounding
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenWeather — weather-aware planning
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Viator Partner API — bookable activities (primary affiliate revenue)
VIATOR_API_KEY=your_viator_api_key_here
VIATOR_AFFILIATE_PID=your_viator_partner_id_here

# GetYourGuide Partner API — bookable activities (secondary affiliate revenue)
GETYOURGUIDE_API_KEY=your_getyourguide_api_key_here
GETYOURGUIDE_PARTNER_ID=your_gyg_partner_id_here

# Ticketmaster Discovery API v2 — live concerts/sports/shows (free tier: 5k calls/day)
TICKETMASTER_API_KEY=your_ticketmaster_consumer_key_here

# Eventbrite — organizer-scoped only (public event search API was retired in 2020).
# Both must be set: a private token AND a comma-separated list of GTA organizer ids
# (the number at the end of an eventbrite.ca/o/... organizer page URL).
EVENTBRITE_PRIVATE_TOKEN=your_eventbrite_private_token_here
EVENTBRITE_ORG_IDS=

# Toronto Open Data festivals/events feed — keyless, on by default for GTA requests.
# Cache TTL in ms (default 12h):
# TORONTO_EVENTS_TTL_MS=43200000

# York Region civic POIs (Markham parks) — experimental, off by default:
# YORK_OPEN_DATA_ENABLED=true

# Supabase (Postgres persistence + Auth in Phase 3)
# Create a project at supabase.com, then Project Settings → API for these.
# Leave unset to run on in-memory storage (data wiped on restart).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
# Force in-memory storage even if the above are set (handy for local/tests):
# DB_BACKEND=memory
# When Supabase/auth is NOT configured, the gated routes can fall back to a
# client-supplied ownerId (no real auth). This is OFF by default so it can't
# silently weaken a misconfigured prod deploy. Set to true ONLY for local dev:
# TRUST_CLIENT_OWNER_ID=true

# ---------- Phase 4: business-model wiring ----------
# Stripe (test mode is fine). Create a recurring Price in the Stripe dashboard
# (Products → Add product → recurring) and paste its price_… id below.
# Without these two, Pro is simply unavailable (503) and the free tier is
# NOT limited — the app keeps working exactly as before.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
# Webhook signing secret (Dashboard → Developers → Webhooks, or `stripe listen`).
# Point the endpoint at POST /api/billing/webhook. Required for Pro activation.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Free-tier limits, enforced only once Stripe is configured (Pro = unlimited).
# Free generates per day per user/guest (default 5):
# FREE_DAILY_GENERATES=5
# Saved plans total on the free tier (default 2):
# FREE_GUIDE_LIMIT=2
# Smart re-plans per day on the free tier — one free taste by default (default 1):
# FREE_DAILY_REPLANS=1

# Internal analytics: GET /admin.html + /api/admin/metrics. Pick a long random
# string. Unset = metrics endpoint disabled (503).
# ADMIN_KEY=change_me_to_something_long_and_random

# NOTE: analytics reads + subscription persistence use SUPABASE_SERVICE_KEY
# (events/subscriptions tables are write-only/no-write for the anon key by
# design). Without it, usage counts and subscriptions live in process memory —
# fine for demos, wiped on restart.

# Server
PORT=3000
NODE_ENV=development

# Default location context (used when user doesn't specify one)
DEFAULT_CITY=Richmond Hill, Ontario
