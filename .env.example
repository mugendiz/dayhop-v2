# Copy this file to .env and fill in your real values. Never commit .env.

# Grok / xAI API (idea selection, curation, day-plan assembly)
GROK_API_KEY=your_xai_api_key_here
GROK_API_URL=https://api.x.ai/v1/chat/completions
# Prefer a fast non-reasoning variant: feed generation is a selection/copy
# task and slow reasoning models can exceed the request timeout. Check
# available ids via GET https://api.x.ai/v1/models with your key.
GROK_MODEL=grok-4.20-0309-non-reasoning

# Google Maps (Places API New + Geocoding) — real venue grounding
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenWeather — weather-aware planning
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Viator Partner API — bookable activities (primary affiliate revenue)
VIATOR_API_KEY=your_viator_api_key_here
VIATOR_AFFILIATE_PID=your_viator_partner_id_here

# GetYourGuide Partner API — bookable activities (secondary affiliate revenue)
GETYOURGUIDE_API_KEY=your_getyourguide_api_key_here
GETYOURGUIDE_PARTNER_ID=your_gyg_partner_id_here

# Ticketmaster Discovery API v2 — live concerts/sports/shows (free tier: 5k calls/day)
TICKETMASTER_API_KEY=your_ticketmaster_consumer_key_here

# Eventbrite — organizer-scoped only (public event search API was retired in 2020).
# Both must be set: a private token AND a comma-separated list of GTA organizer ids
# (the number at the end of an eventbrite.ca/o/... organizer page URL).
EVENTBRITE_PRIVATE_TOKEN=your_eventbrite_private_token_here
EVENTBRITE_ORG_IDS=

# Seeker Events API (seeker.io) — hyperlocal community events (markets,
# pop-ups, neighbourhood gatherings). Access is request-only: apply at
# seeker.io/events/events-api, then set BOTH values from their onboarding.
# SEEKER_API_URL=
# SEEKER_API_KEY=

# Regional municipal event calendars (GHD iCreate platform) — keyless, on by
# default for GTA requests with Richmond Hill, Durham Region, and Oshawa.
# Override/extend with semicolon-separated "Label|https://calendar.town.ca/calendarName":
# CIVIC_CALENDAR_FEEDS=Richmond Hill|https://calendar.richmondhill.ca/default;Durham Region|https://calendar.durham.ca/tourismevents

# Attractions Ontario (GTA-region festivals/events via public WP REST) and
# Toronto Open Data festivals/events feed — keyless, on by default for GTA requests.
# Cache TTL in ms (default 12h):
# TORONTO_EVENTS_TTL_MS=43200000

# York Region civic POIs (Markham parks) — experimental, off by default:
# YORK_OPEN_DATA_ENABLED=true

# Supabase (Postgres persistence + Auth in Phase 3)
# Create a project at supabase.com, then Project Settings → API for these.
# Leave unset to run on in-memory storage (data wiped on restart).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
# Force in-memory storage even if the above are set (handy for local/tests):
# DB_BACKEND=memory
# When Supabase/auth is NOT configured, the gated routes can fall back to a
# client-supplied ownerId (no real auth). This is OFF by default so it can't
# silently weaken a misconfigured prod deploy. Set to true ONLY for local dev:
# TRUST_CLIENT_OWNER_ID=true

# ---------- Phase 4: business-model wiring ----------
# Stripe (test mode is fine). Create a recurring Price in the Stripe dashboard
# (Products → Add product → recurring) and paste its price_… id below.
# Without these two, Pro is simply unavailable (503) and the free tier is
# NOT limited — the app keeps working exactly as before.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
# Webhook signing secret (Dashboard → Developers → Webhooks, or `stripe listen`).
# Point the endpoint at POST /api/billing/webhook. Required for Pro activation.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Free-tier limits, enforced only once Stripe is configured (Pro = unlimited).
# Free generates per day per user/guest (default 5):
# FREE_DAILY_GENERATES=3
# Saved plans total on the free tier (default 2):
# FREE_GUIDE_LIMIT=2
# Smart re-plans per day on the free tier — one free taste by default (default 1):
# FREE_DAILY_REPLANS=1

# Internal analytics: GET /admin.html + /api/admin/metrics. Pick a long random
# string. Unset = metrics endpoint disabled (503).
# ADMIN_KEY=change_me_to_something_long_and_random

# ---------- Discovery buzz signals (admin Discovery inbox) ----------
# Google News mention-velocity is always on (keyless). These two deepen the
# 0-100 buzz score; both optional, both fail-soft when unset.
# Reddit: create a free "script" app at reddit.com/prefs/apps →
# REDDIT_CLIENT_ID=...
# REDDIT_CLIENT_SECRET=...
# YouTube Data API v3 key (free 10k units/day; ~100 units per buzz check):
# YOUTUBE_API_KEY=...
# Override the discovery RSS feed list ("Label|url;Label|url"):
# NEW_OPENINGS_FEEDS=Curiocity|https://curiocity.com/feed/;...

# ---------- Discovery autopilot (auto-add verified finds to the catalog) ----------
# Runs automatically every Sunday at midnight (Toronto time) when
# GROK_API_KEY is set: scans Canada-wide feeds, verifies each find (a
# Google Places closed-tag veto — only an explicit "closed" listing blocks
# — plus the Grok editorial gate), and publishes passers into the live
# catalog. Rejected finds stay in the admin inbox for human review. The
# admin "Scan feeds" button runs the same pipeline on demand any day.
# Disable the scheduled scan (admin "Scan feeds" button still works):
# DISCOVERY_AUTO=off
# Persistence for auto-added entries uses SUPABASE_SERVICE_KEY (table
# public.auto_catalog — run db/schema.sql); without it they live in process
# memory until restart.

# NOTE: analytics reads + subscription persistence use SUPABASE_SERVICE_KEY
# (events/subscriptions tables are write-only/no-write for the anon key by
# design). Without it, usage counts and subscriptions live in process memory —
# fine for demos, wiped on restart.

# ---------- Email marketing (weekly digest + transactional) ----------
# Resend (resend.com — free tier: 3,000 emails/mo, 100/day). Without the key
# everything fails soft: subscribe forms still record consent (pending state),
# no email goes out. To go live:
#   1. Create a Resend account, add + verify the sending domain (dayhop.quest)
#      — Resend gives you the SPF + DKIM DNS records to add.
#   2. Publish a DMARC record too (start with p=none):
#      _dmarc.dayhop.quest TXT "v=DMARC1; p=none; rua=mailto:admin@dayhop.quest"
#   3. Paste the API key below.
# RESEND_API_KEY=re_...
# Verified sender + reply address (replies are read by a human — see docs):
# EMAIL_FROM=DayHop <hello@dayhop.quest>
# EMAIL_REPLY_TO=admin@dayhop.quest
# Weekly digest goes out Thursdays 9:00-9:59 Toronto time when RESEND_API_KEY
# is set. Override the hour (0-23) or disable the schedule (admin manual send
# still works):
# DIGEST_HOUR=9
# DIGEST_AUTO=off
# Confirm/unsubscribe links use RENDER_EXTERNAL_URL in prod; override with:
# PUBLIC_BASE_URL=https://dayhop-v2.onrender.com

# ---------- Ads (Meta Pixel + Conversions API) ----------
# All fail-soft: nothing set → no third-party script loads, no events send.
# UTM attribution (?utm_source=…) is captured regardless — it needs no keys.
# Full runbook: docs/ads.md
# 1. Meta Business account → Events Manager → create a pixel/dataset; the
#    numeric ID goes here (public by design — it ships to every browser):
# META_PIXEL_ID=1234567890
# 2. Events Manager → Settings → Conversions API → Generate access token
#    (unlocks server-side events: Lead, CompleteRegistration,
#    InitiateCheckout, StartTrial — these survive ad blockers):
# META_CAPI_TOKEN=EAAG...
# 3. While testing: Events Manager → Test events tab shows the code. Events
#    route to the test tab instead of live data. REMOVE for production:
# META_TEST_EVENT_CODE=TEST12345

# ---------- Outreach CRM (sponsorship pipeline automation) ----------
# Daily cadence (8 AM Toronto): approved opener → bump day 4 → close day 10.
# Rides on RESEND_API_KEY above; per-flag off switches:
# OUTREACH_AUTO=off        # stop the daily cadence (CRM tab buttons still work)
# OPERATOR_REPORT=off      # stop the Monday 9 AM operator report email
# OPERATOR_REPORT_TO=dayhopadmin@gmail.com   # report recipient (this is the default)
# OUTREACH_FROM="Andrew at DayHop <hello@dayhop.quest>"  # founder-voice sender (default)
# Resend dashboard → Webhooks → endpoint https://dayhop.quest/api/webhooks/resend
# (events: email.delivered, email.opened, email.bounced) — signing secret:
# RESEND_WEBHOOK_SECRET=whsec_...

# ---------- Google Analytics 4 ----------
# Same fail-soft contract as the pixel: unset → gtag.js never loads.
# GA property "DayHop" (account: Zoka Developer Store), web stream dayhop.quest.
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Server
PORT=3000
NODE_ENV=development

# Default location context (used when user doesn't specify one)
DEFAULT_CITY=Richmond Hill, Ontario

# ---------- Content webhook (SEO blog) ----------
# Shared secret for POST /api/content/webhook — point BabyLoveGrowth (or any
# article tool) at https://<host>/api/content/webhook with this secret as
# "Authorization: Bearer <secret>" (or X-Webhook-Secret / ?secret=).
# Articles render at /blog/<slug>. Unset = webhook returns 503 (blog still
# serves the built-in seed stories).
# CONTENT_WEBHOOK_SECRET=change_me_to_something_long_and_random
