# Copy this file to .env and fill in your real values. Never commit .env.

# Grok / xAI API (idea selection, curation, day-plan assembly)
GROK_API_KEY=your_xai_api_key_here
GROK_API_URL=https://api.x.ai/v1/chat/completions
GROK_MODEL=grok-4

# Google Maps (Places API New + Geocoding) — real venue grounding
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenWeather — weather-aware planning
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Viator Partner API — bookable activities (primary affiliate revenue)
VIATOR_API_KEY=your_viator_api_key_here
VIATOR_AFFILIATE_PID=your_viator_partner_id_here

# GetYourGuide Partner API — bookable activities (secondary affiliate revenue)
GETYOURGUIDE_API_KEY=your_getyourguide_api_key_here
GETYOURGUIDE_PARTNER_ID=your_gyg_partner_id_here

# Server
PORT=3000
NODE_ENV=development

# Default location context (used when user doesn't specify one)
DEFAULT_CITY=Richmond Hill, Ontario
